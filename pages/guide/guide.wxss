.page {
  padding: 24rpx 28rpx 60rpx;
}
.section {
  margin-bottom: 36rpx;
}
.h {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  color: #07c160;
}
.p {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  display: block;
}
.li {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #07c160;
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.li .k {
  font-weight: 600;
  font-size: 28rpx;
  display: block;
}
.li .v {
  font-size: 26rpx;
  color: #888;
  display: block;
  margin-top: 4rpx;
}
.tip-blue, .tip-green, .tip-orange {
  font-size: 27rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
  line-height: 1.6;
}
.tip-blue {
  background: #eef7ff;
  color: #1565c0;
}
.tip-green {
  background: #f6ffed;
  color: #389e0d;
}
.tip-orange {
  background: #fff7e6;
  color: #d46b08;
}
.back-btn {
  background: #07c160;
  color: #fff;
  border-radius: 16rpx;
  margin-top: 20rpx;
}
