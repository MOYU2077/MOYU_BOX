/* index.wxss —— 圆形号码球 + 质感 UI + 白天/黑夜模式（CSS 变量） */
.page {
  --bg:#f3f4f6; --card:#ffffff; --text:#1d1f23; --label:#525860; --sub:#9aa0a8;
  --input:#f4f5f7; --border:#e9eaee; --border-strong:#dfe1e6;
  --accent:#07c160; --accent-2:#06ad56; --accent-soft:#e9f8ef;
  --shadow:0 8rpx 24rpx rgba(17,24,39,.07); --shadow-sm:0 2rpx 10rpx rgba(17,24,39,.05);
  --ball-green:#07c160; --ball-red:#fa5151; --ball-gray:#c9ccd2;
  --ball-amt-green:#07c160; --ball-amt-red:#fa5151; --ball-amt-gray:#9aa0a8;
  --info-bg:#eaf3ff; --info-tx:#1565c0;
  --enough-bg:#edfbf0; --enough-tx:#1a9e4b;
  --short-bg:#fff1f0; --short-tx:#e03a3a;
  --lack-bg:#fff4ec; --lack-tx:#e0730a;
  --total-tx:#106b39;
  min-height:100vh; padding:24rpx 28rpx 60rpx; color:var(--text);
  background:var(--bg); transition:background .25s, color .25s;
}
.page.dark {
  --bg:#0e1014; --card:#191c22; --text:#e9ebef; --label:#aab1bc; --sub:#727884;
  --input:#242932; --border:#2a2f38; --border-strong:#333a44;
  --accent:#2ecc71; --accent-2:#27b363; --accent-soft:#143027;
  --shadow:0 10rpx 28rpx rgba(0,0,0,.5); --shadow-sm:0 2rpx 12rpx rgba(0,0,0,.4);
  --ball-green:#2ecc71; --ball-red:#ff5a5a; --ball-gray:#3a404a;
  --ball-amt-green:#5fd994; --ball-amt-red:#ff7a7a; --ball-amt-gray:#8b9099;
  --info-bg:#15263d; --info-tx:#7cb8ff;
  --enough-bg:#15301f; --enough-tx:#5fd994;
  --short-bg:#3a1d1d; --short-tx:#ff8585;
  --lack-bg:#33241a; --lack-tx:#ffa44d;
  --total-tx:#5fd994;
}
.header { display:flex; align-items:center; justify-content:space-between; padding:8rpx 4rpx 20rpx; }
.title { font-size:40rpx; font-weight:700; letter-spacing:1rpx; }
.subtitle { font-size:24rpx; color:var(--sub); margin-top:8rpx; }
.theme-btn { flex-shrink:0; width:84rpx; height:84rpx; border-radius:50%; border:1rpx solid var(--border);
  background:var(--card); display:flex; align-items:center; justify-content:center; font-size:36rpx;
  box-shadow:var(--shadow-sm); }
.empty { text-align:center; color:var(--sub); margin:120rpx 0; white-space:pre-line; line-height:1.9; font-size:28rpx; }
.card { background:var(--card); border-radius:36rpx; padding:28rpx; margin-bottom:28rpx;
  box-shadow:var(--shadow); border:1rpx solid var(--border); transition:background .25s, border-color .25s; }
.card-head { display:flex; align-items:center; justify-content:space-between; border-bottom:1rpx solid var(--border); padding-bottom:16rpx; margin-bottom:8rpx; }
.card-name { font-size:32rpx; font-weight:600; flex:1; min-width:0; background:transparent; color:var(--text); }
.card-del { font-size:26rpx; color:#fa5151; padding-left:20rpx; flex-shrink:0; }
.field { display:flex; align-items:center; justify-content:space-between; padding:14rpx 0; }
.field-label { font-size:28rpx; color:var(--label); flex:1; min-width:0; }
.field-label-col { flex:1; min-width:0; display:flex; flex-direction:column; }
.field-sub { font-size:22rpx; color:var(--sub); margin-top:4rpx; }
.field-input { width:240rpx; flex-shrink:0; text-align:right; background:var(--input); border:1rpx solid var(--border);
  border-radius:20rpx; padding:14rpx 20rpx; font-size:30rpx; color:var(--text); transition:border-color .15s, box-shadow .15s; }
.field-input:focus { border-color:var(--accent); box-shadow:0 0 0 6rpx var(--accent-soft); }
.field-auto { font-size:32rpx; font-weight:600; color:var(--accent); min-width:80rpx; text-align:right; }
.sample-block { background:var(--input); border-radius:24rpx; padding:16rpx 20rpx; margin:12rpx 0; border:1rpx solid var(--border); }
.use-head { display:flex; justify-content:space-between; align-items:baseline; margin-bottom:8rpx; }
.use-hint { font-size:22rpx; color:var(--accent); flex-shrink:0; }
.sample-row { display:flex; align-items:center; padding:10rpx 0; }
.s-label { font-size:26rpx; color:var(--sub); flex-shrink:0; }
.s-num { width:84rpx; flex-shrink:0; text-align:center; background:var(--card); border:1rpx solid var(--border); border-radius:16rpx; padding:12rpx 4rpx; font-size:30rpx; margin:0 6rpx; color:var(--text); }
.s-amount { flex:1; min-width:0; text-align:right; background:var(--card); border:1rpx solid var(--border); border-radius:16rpx; padding:12rpx 20rpx; font-size:30rpx; margin:0 16rpx 0 6rpx; color:var(--text); }
.use-del { font-size:40rpx; color:#fa5151; width:40rpx; flex-shrink:0; text-align:center; line-height:1; }
.use-add { text-align:center; font-size:26rpx; color:var(--accent); padding:16rpx 0; border:1rpx dashed var(--accent); border-radius:16rpx; margin-top:8rpx; }
.result { margin-top:16rpx; }
.result-line { font-size:28rpx; padding:20rpx 24rpx; border-radius:20rpx; margin-top:16rpx; line-height:1.5; }
.info { background:var(--info-bg); color:var(--info-tx); }
.enough { background:var(--enough-bg); color:var(--enough-tx); }
.short { background:var(--short-bg); color:var(--short-tx); }
.lack { background:var(--lack-bg); color:var(--lack-tx); font-weight:600; }
.add-btn { background:linear-gradient(135deg,var(--accent),var(--accent-2)); color:#fff; border-radius:28rpx; font-size:30rpx; font-weight:600; margin-top:16rpx; box-shadow:0 8rpx 20rpx rgba(7,193,96,.25); }
.guide-link { text-align:center; color:var(--accent); font-size:26rpx; margin-top:36rpx; }
/* 浆料标签行（横向滚动 · 圆形号码球，像双色球） */
.chip-scroll { margin-top:12rpx; white-space:nowrap; }
.chip-row { display:inline-flex; align-items:flex-start; padding:6rpx 0; }
.chip { flex:none; display:flex; flex-direction:column; align-items:center; width:110rpx; margin-right:14rpx; }
.ball {
  width:80rpx; height:80rpx; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  font-weight:700; color:#fff; background:var(--ball-gray);
  box-shadow:0 4rpx 12rpx rgba(0,0,0,.18); transition:transform .15s, box-shadow .15s;
}
.ball.green { background:var(--ball-green); }
.ball.red   { background:var(--ball-red); }
.ball.gray  { background:var(--ball-gray); }
.ball-add   { background:var(--card); border:3rpx dashed var(--accent); color:var(--accent); }
.ball-full  { background:var(--input); border:3rpx solid var(--border-strong); color:var(--sub); }
.chip-on .ball { transform:scale(1.1); box-shadow:0 6rpx 20rpx rgba(0,0,0,.3); }
.ball-amt { font-size:22rpx; margin-top:10rpx; line-height:1; }
.ball-amt.green { color:var(--ball-amt-green); }
.ball-amt.red   { color:var(--ball-amt-red); }
.ball-amt.gray  { color:var(--ball-amt-gray); }
/* 选中浆料详情（抽屉 / Tab 内容） */
.slurry-detail { margin-top:12rpx; border-top:1rpx dashed var(--border); padding-top:12rpx; }
.slurry-panel { animation:fadeIn .18s ease; }
@keyframes fadeIn { from { opacity:.3; transform:translateY(8rpx); } to { opacity:1; transform:translateY(0); } }
.slurry-panel-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:8rpx; }
.slurry-name { font-size:30rpx; font-weight:600; flex:1; min-width:0; background:var(--input); border:1rpx solid var(--border); border-radius:20rpx; padding:14rpx 18rpx; color:var(--text); }
.slurry-del { font-size:24rpx; color:#fa5151; padding-left:18rpx; flex-shrink:0; }
/* 底部吸底操作条 */
.action-bar { position:sticky; bottom:8rpx; display:flex; align-items:center; justify-content:space-between; margin-top:20rpx; padding:16rpx 20rpx; background:var(--card); border:1rpx solid var(--border); border-radius:28rpx; box-shadow:0 -4rpx 18rpx rgba(0,0,0,.08); transition:background .25s, border-color .25s; }
.page.dark .action-bar { box-shadow:0 -4rpx 18rpx rgba(0,0,0,.45); }
.action-total { font-size:28rpx; font-weight:700; color:var(--total-tx); flex:1; min-width:0; }
.apply-btn2 { background:linear-gradient(135deg,var(--accent),var(--accent-2)); color:#fff; border:none; border-radius:20rpx; font-size:28rpx; padding:0 28rpx; height:72rpx; line-height:72rpx; margin:0 0 0 16rpx; flex-shrink:0; font-weight:600; box-shadow:0 6rpx 16rpx rgba(7,193,96,.25); }
